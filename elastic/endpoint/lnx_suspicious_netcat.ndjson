{"version": 1, "type": "detection-rule", "rule_id": "fa0253e4-a1ad-40e1-8d53-2e8009de055e", "name": "Linux Netcat Execution", "description": "Detects suspicious netcat execution.", "risk_score": 50, "severity": "medium", "author": ["Jules"], "tags": ["MITRE:T1059.004"], "query": "process.name:(nc OR ncat OR netcat) AND process.args:(-e OR -c)", "index": ["logs-*"], "language": "kuery", "enabled": true, "threat": []}