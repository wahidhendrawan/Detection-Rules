{"version": 1, "type": "detection-rule", "rule_id": "58fcff98-0f18-41d8-8500-acfbc5e95286", "name": "Windows Shadow Copy Deletion", "description": "Detects deletion of shadow copies.", "risk_score": 50, "severity": "medium", "author": ["Jules"], "tags": ["MITRE:T1490"], "query": "process.name:vssadmin.exe AND process.args:delete AND process.args:shadows", "index": ["logs-*"], "language": "kuery", "enabled": true, "threat": []}