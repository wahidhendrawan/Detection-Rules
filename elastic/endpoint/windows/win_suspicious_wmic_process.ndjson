{"version":1,"type":"detection-rule","rule_id":"92d16b7b-81b0-4416-b9be-5715fd4becbe","name":"Windows WMIC Process Call","description":"Detects WMIC creating processes.","risk_score":50,"severity":"medium","author":["Jules"],"tags":["MITRE:T1047"],"query":"process.name:wmic.exe AND process.args:process AND process.args:call AND process.args:create","index":["logs-*"],"language":"kuery","enabled":true,"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0002","name":"Execution","reference":"https://attack.mitre.org/tactics/TA0002/"},"technique":[{"id":"T1047","name":"Windows Management Instrumentation","reference":"https://attack.mitre.org/techniques/T1047/"}]}]}