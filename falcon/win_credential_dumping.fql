// CrowdStrike Falcon Query Language (FQL)
// Title: Credential Dumping Activity
// Description: Detects command patterns associated with credential dumping.
// Author: Security Team
// Date: 2026-08-01
// MITRE ATT&CK: T1003
// Tactic: Credential Access
// Severity: Critical
// References:
//   - https://attack.mitre.org/techniques/T1003/

event_simpleName=ProcessRollup2
| CommandLine=*sekurlsa* OR CommandLine=*lsass.dmp* OR CommandLine=*comsvcs.dll* OR CommandLine=*MiniDump*
| table aid, TargetProcessId, ParentProcessId, FileName, CommandLine, UserName, timestamp
