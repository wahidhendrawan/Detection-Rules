// Title: File Create Dll Temp
// Description: Hunts for file create dll temp
// MITRE ATT&CK: T1574.002
// Severity: informational
// FalsePositives:
//   - Software install/update yang sah membuat file di path tersebut.
FileCreationEvents | where FolderPath contains 'AppData\\Local\\Temp' and FileName endswith '.dll'
