// Title: Input Capture
// Description: Detects indicators of Input Capture (T1056)
// MITRE ATT&CK: T1056
// Severity: medium
// Tactic: collection
// Author: Wahid Hendrawan
// Date: 2026-06-04
// References:
//   - https://attack.mitre.org/techniques/T1056/

DeviceProcessEvents
| where Timestamp > ago(24h)
| where ProcessCommandLine has_any ('GetAsyncKeyState','SetWindowsHookEx','keylog')
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine,
          InitiatingProcessFileName, InitiatingProcessCommandLine
| order by Timestamp desc
