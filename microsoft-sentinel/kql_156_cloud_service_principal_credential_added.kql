// Title: Service Principal Credential Added
// Description: Detects credentials added to applications or service principals.
// Author: Security Team
// Date: 2026-08-01
// MITRE ATT&CK: T1098.001
// Tactic: Persistence
// Severity: Critical
// DataConnector: Identity audit and sign-in logs
// References:
//   - https://attack.mitre.org/techniques/T1098/
// False Positives:
//   - Authorized identity administration or known automation.

AuditLogs
| where TimeGenerated > ago(24h)
| where OperationName has_any ("Add service principal credentials", "Certificates and secrets management")
| where Result =~ "success"
| project TimeGenerated, OperationName, InitiatedBy, TargetResources, CorrelationId
| order by TimeGenerated desc
