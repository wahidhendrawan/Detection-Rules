// Title: macOS osascript Abuse
// Description: Detects suspicious execution of osascript for automation or lateral movement.
// Author: Security Team
// Date: 2026-08-01
// MITRE ATT&CK: T1059.002
// Tactic: Execution
// Severity: Medium
// DataConnector: Endpoint detection and response logs

DeviceProcessEvents
| where Timestamp > ago(24h)
| where FileName == "osascript"
| where ProcessCommandLine has_any ("-e", "do shell script")
| project Timestamp, DeviceName, AccountName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp desc
