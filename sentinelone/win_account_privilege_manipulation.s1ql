// SentinelOne Deep Visibility Query
// Title: Account Privilege Manipulation
// Description: Detects users added to privileged local groups.
// Author: Security Team
// Date: 2026-08-01
// MITRE ATT&CK: T1098
// Tactic: Persistence, Privilege Escalation
// Severity: High
// References:
//   - https://attack.mitre.org/techniques/T1098/

EventType = "Process Creation" AND
SrcProcName In Contains Anycase ("net.exe", "net1.exe", "powershell.exe") AND
SrcProcCmdLine Contains Anycase ("localgroup administrators", "Add-LocalGroupMember")
