// SentinelOne Deep Visibility Query
// Title: Credential Dumping Tool Execution
// Description: Detects commands associated with dumping LSASS or registry credentials.
// Author: Security Team
// Date: 2026-08-01
// MITRE ATT&CK: T1003
// Tactic: Credential Access
// Severity: Critical
// References:
//   - https://attack.mitre.org/techniques/T1003/

EventType = "Process Creation" AND
SrcProcCmdLine Contains Anycase ("sekurlsa", "lsass.dmp", "comsvcs.dll", "MiniDump", "reg save hklm\sam")
