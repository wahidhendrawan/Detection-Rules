# Title: macOS Defaults Security Tampering
# Description: Detects defaults changes affecting macOS security controls.
# Author: Security Team
# Date: 2026-08-01
# MITRE ATT&CK: T1112
# Tactic: defense_evasion
# Severity: medium
# References:
#   - https://attack.mitre.org/techniques/T1112/
# False Positives:
#   - Authorized macOS administration or software deployment.

index=macos OR index=endpoint sourcetype IN ("osquery:results", "endpoint:process", "endpoint:file")
process_name="defaults" (process_command_line="*LSQuarantine*" OR process_command_line="*DisableGatekeeper*" OR process_command_line="*AppleShowAllFiles*")
| stats count, values(process_command_line) as command_line, values(user) as user by host, process_name, file_path
| where count > 0
| sort - _time
