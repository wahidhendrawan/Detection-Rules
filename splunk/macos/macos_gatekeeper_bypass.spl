# Title: macOS Gatekeeper Bypass
# Description: Detects xattr or spctl used to bypass Gatekeeper.
# Author: Security Team
# Date: 2026-08-01
# MITRE ATT&CK: T1553.001
# Tactic: defense_evasion
# Severity: high
# References:
#   - https://attack.mitre.org/techniques/T1553/
# False Positives:
#   - Authorized macOS administration or software deployment.

index=macos OR index=endpoint sourcetype IN ("osquery:results", "endpoint:process", "endpoint:file")
process_name IN ("xattr","spctl") (process_command_line="*com.apple.quarantine*" OR process_command_line="*--master-disable*")
| stats count, values(process_command_line) as command_line, values(user) as user by host, process_name, file_path
| where count > 0
| sort - _time
