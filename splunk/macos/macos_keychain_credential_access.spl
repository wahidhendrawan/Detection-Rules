# Title: macOS Keychain Credential Access
# Description: Detects security utility access to Keychain credentials.
# Author: Security Team
# Date: 2026-08-01
# MITRE ATT&CK: T1555.001
# Tactic: credential_access
# Severity: high
# References:
#   - https://attack.mitre.org/techniques/T1555/
# False Positives:
#   - Authorized macOS administration or software deployment.

index=macos OR index=endpoint sourcetype IN ("osquery:results", "endpoint:process", "endpoint:file")
process_name="security" (process_command_line="*dump-keychain*" OR process_command_line="*find-generic-password*" OR process_command_line="*find-internet-password*")
| stats count, values(process_command_line) as command_line, values(user) as user by host, process_name, file_path
| where count > 0
| sort - _time
