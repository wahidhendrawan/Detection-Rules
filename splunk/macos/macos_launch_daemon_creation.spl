# Title: macOS LaunchDaemon Persistence
# Description: Detects LaunchDaemon plist creation.
# Author: Security Team
# Date: 2026-08-01
# MITRE ATT&CK: T1543.004
# Tactic: persistence
# Severity: critical
# References:
#   - https://attack.mitre.org/techniques/T1543/
# False Positives:
#   - Authorized macOS administration or software deployment.

index=macos OR index=endpoint sourcetype IN ("osquery:results", "endpoint:process", "endpoint:file")
file_path="*/Library/LaunchDaemons/*.plist"
| stats count, values(process_command_line) as command_line, values(user) as user by host, process_name, file_path
| where count > 0
| sort - _time
