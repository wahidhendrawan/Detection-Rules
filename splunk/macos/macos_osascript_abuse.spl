# Title: macOS osascript Abuse
# Description: Detects AppleScript executing shell or download commands.
# Author: Security Team
# Date: 2026-08-01
# MITRE ATT&CK: T1059.002
# Tactic: execution
# Severity: high
# References:
#   - https://attack.mitre.org/techniques/T1059/
# False Positives:
#   - Authorized macOS administration or software deployment.

index=macos OR index=endpoint sourcetype IN ("osquery:results", "endpoint:process", "endpoint:file")
process_name="osascript" (process_command_line="*do shell script*" OR process_command_line="*curl*" OR process_command_line="*wget*")
| stats count, values(process_command_line) as command_line, values(user) as user by host, process_name, file_path
| where count > 0
| sort - _time
