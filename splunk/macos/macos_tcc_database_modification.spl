# Title: macOS TCC Database Modification
# Description: Detects direct modification of the TCC privacy database.
# Author: Security Team
# Date: 2026-08-01
# MITRE ATT&CK: T1562.001
# Tactic: defense_evasion
# Severity: critical
# References:
#   - https://attack.mitre.org/techniques/T1562/
# False Positives:
#   - Authorized macOS administration or software deployment.

index=macos OR index=endpoint sourcetype IN ("osquery:results", "endpoint:process", "endpoint:file")
process_command_line="*TCC.db*" (process_name="sqlite3" OR process_command_line="*com.apple.TCC*")
| stats count, values(process_command_line) as command_line, values(user) as user by host, process_name, file_path
| where count > 0
| sort - _time
