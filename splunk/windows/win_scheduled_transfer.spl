# Title: Scheduled Transfer
# MITRE ATT&CK: T1029
# Tactic: exfiltration
# Severity: medium
# Author: Wahid Hendrawan
# Date: 2026-06-04
# References:
#   - https://attack.mitre.org/techniques/T1029/

index=windows OR index=endpoint
sourcetype IN ("XmlWinEventLog:Microsoft-Windows-Sysmon/Operational", "WinEventLog:Security")
schtasks AND (ftp OR http OR scp)
| stats count, values(CommandLine) as cmd, values(User) as user by _time, host, Image, ParentImage
| where count > 0
| sort - _time
