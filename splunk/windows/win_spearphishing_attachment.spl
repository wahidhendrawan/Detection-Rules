# Title: Spearphishing Attachment
# MITRE ATT&CK: T1566.001
# Tactic: initial-access
# Severity: medium
# Author: Wahid Hendrawan
# Date: 2026-06-04

index=windows OR index=endpoint
sourcetype IN ("XmlWinEventLog:Microsoft-Windows-Sysmon/Operational", "WinEventLog:Security")
ParentImage=*OUTLOOK.EXE* OR ParentImage=*WINWORD.EXE* (Image=*cmd.exe* OR Image=*powershell.exe*)
| stats count, values(CommandLine) as cmd, values(User) as user by _time, host, Image
| where count > 0
| sort - _time
