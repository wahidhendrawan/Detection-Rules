# Verification pipeline config
# Copy to config.yml and fill in your values

backend: elastic  # elastic | splunk | sentinel

elastic:
  url: https://localhost:9200
  username: elastic
  # password from env: ELASTIC_PASSWORD
  index: ".alerts-security.alerts-default"
  verify_ssl: false

splunk:
  url: https://localhost:8089
  token_env: SPLUNK_TOKEN
  index: notable

sentinel:
  workspace_id: "your-workspace-id"
  # Uses az login / DefaultAzureCredential
