<group name="attack,privilege_escalation">
  <rule id="100244" level="8">
    <decoded_as>syslog</decoded_as>
    <regex type="pcre2">InitiatingProcessFileName in~ ('fodhelper.exe','eventvwr.exe') and FileName in~ ('cmd.exe','powershell.exe')</regex>
    <description>Abuse Elevation Control Mechanism (T1548)</description>
    <mitre>
      <id>T1548</id>
    </mitre>
  </rule>
</group>
