<group name="attack,credential_access">
  <rule id="100246" level="8">
    <decoded_as>syslog</decoded_as>
    <regex type="pcre2">TargetFileName has_any ('web.config','.env','credentials.xml','appsettings.json')</regex>
    <description>Credentials In Files (T1552.001)</description>
    <mitre>
      <id>T1552.001</id>
    </mitre>
  </rule>
</group>
