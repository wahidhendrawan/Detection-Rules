<!--
  Title: macOS Keychain Credential Access
  Description: Detects attempts to access or dump the macOS Keychain.
  Author: Security Team
  Date: 2026/08/01
  MITRE ATT&CK: T1555.001
  Tactic: CredentialAccess
  Severity: 10
  References:
    - https://attack.mitre.org/techniques/T1555.001/
-->
<group name="attack,macos,">
  <rule id="100306" level="10">
    <if_sid>592</if_sid>
    <field name="audit.process.name">security</field>
    <match>dump-keychain|find-generic-password|find-internet-password</match>
    <description>macOS Keychain access attempt: $(audit.process.path) $(audit.process.arguments).</description>
    <mitre>
      <id>T1555.001</id>
    </mitre>
  </rule>
</group>
