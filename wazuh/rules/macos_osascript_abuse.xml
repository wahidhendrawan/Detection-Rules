<!--
  Title: macOS osascript Abuse
  Description: Detects suspicious execution of osascript for automation or command execution.
  Author: Security Team
  Date: 2026/08/01
  MITRE ATT&CK: T1059.002
  Tactic: Execution
  Severity: 5
  References:
    - https://attack.mitre.org/techniques/T1059.002/
-->
<group name="attack,macos,">
  <rule id="100304" level="5">
    <if_sid>592</if_sid>
    <field name="audit.process.name">osascript</field>
    <match> -e |do shell script</match>
    <description>Suspicious osascript execution: $(audit.process.path) $(audit.process.arguments).</description>
    <mitre>
      <id>T1059.002</id>
    </mitre>
  </rule>
</group>
