<!--
  Severity: medium (single event = informational, threshold = medium)
  FalsePositives:
    - Admin yang salah ketik password berulang kali.
    - Vulnerability scanner authenticated scan.
  Notes:
    - Single 'Failed password for root' = level 5 (informational).
    - 5 atau lebih dalam 120s dari source yang sama = level 10 (brute force).
    - Pakai <if_matched_sid> + <frequency> untuk threshold-based alerting.
-->
<group name="attack,net,credential_access">
  <!-- Rule dasar single event -->
  <rule id="100117" level="5">
    <decoded_as>syslog</decoded_as>
    <match>Failed password for root</match>
    <description>SSH root login failed (single event)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!-- Rule threshold: 5 failed in 120s = brute force -->
  <rule id="100201" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100117</if_matched_sid>
    <same_source_ip />
    <description>SSH root brute force: 5 failed login dalam 120s dari source yg sama</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>
</group>
