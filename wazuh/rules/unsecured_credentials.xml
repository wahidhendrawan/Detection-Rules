<group name="attack,credential_access">
  <rule id="100245" level="8">
    <decoded_as>syslog</decoded_as>
    <regex type="pcre2">ProcessCommandLine has_any ('findstr /si password','dir /s *password*','dir /s *.kdbx')</regex>
    <description>Unsecured Credentials (T1552)</description>
    <mitre>
      <id>T1552</id>
    </mitre>
  </rule>
</group>
