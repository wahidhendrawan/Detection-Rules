    <field name="data.command">(?i)(curl|wget).*(\||;).*(sh|bash)</field>
    <description>Custom detection: wazuh_lnx_curl_wget_to_shell</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>
</group>
